# Configuração de Produção - Socorre AI Backend
NODE_ENV=production
PORT=3001

# Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=socorre_ai_production
DB_USER=socorre_ai_user
DB_PASSWORD=your_secure_password_here

# JWT
JWT_SECRET=your_super_secure_jwt_secret_here_production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=https://yourdomain.com,https://admin.yourdomain.com

# Upload de Imagens
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,webp

# G2 — armazenamento privado local das fotos de guincho (VPS, sem bucket externo).
# Precisa estar FORA de UPLOAD_DIR/public: o conteúdo só é servido pelo endpoint
# autenticado /api/upload/emergency-requests/:id/photos/:photo_type.
# Diretórios 0700, arquivos 0600. Sem esta variável o upload de fotos responde 503.
SERVICE_PHOTO_STORAGE_DIR=/var/lib/socorre-ai/private/service-photos

# MVP-01 EXT — armazenamento privado local dos documentos de guincho (Tow).
# Obrigatório em produção e precisa estar FORA da árvore de release substituível
# do backend (o deploy de homologação usa `rsync -a --delete`); o backend recusa
# subir em produção sem esta variável ou apontando para dentro do backend/uploads.
# Diretórios 0700, arquivos 0600.
TOW_DOCUMENT_STORAGE_DIR=/var/lib/socorre-ai/private/tow-documents

# MVP-02 — Google Routes API (server-side, distância autoritativa do guincho).
# Chave SEPARADA da chave de navegador do frontend: restrição de aplicação por
# IP/CIDR do servidor (não por referrer de site) e restrição de API incluindo
# "Routes API". Sem esta variável o cálculo de rota/preço responde 503
# external_dependency_unavailable (nunca um preço estimado).
GOOGLE_ROUTES_API_KEY=your_server_side_google_routes_api_key

# TOW ROUND — reverse geocoding (address enrichment, OPTIONAL).
# `none` (default) disables it; `google` enables the best-effort backend fallback
# for requests that arrive without `formatted_address`. A provider failure never
# fails a Tow create. Requires its OWN server-side key (never the browser Maps
# key, never the Routes key): with TOW_ADDRESS_RESOLVER=google a missing
# GOOGLE_GEOCODING_API_KEY is a startup configuration error.
TOW_ADDRESS_RESOLVER=none
GOOGLE_GEOCODING_API_KEY=your_server_side_google_geocoding_api_key

# PHASE 5 — Service Location (Places API New backend proxy).
# `none` (default) answers a controlled 503; `google` enables the Autocomplete +
# Place Details proxy. Requires its OWN server-side key restricted by IP +
# "Places API (New)" — never the mobile GOOGLE_MAPS_API_KEY. A missing key with
# SERVICE_LOCATION_PLACES=google is a startup configuration error.
# PRODUCTION_KEY_HARDENING_REQUIRED: distinct keys, API/IP restrictions, rotation.
SERVICE_LOCATION_PLACES=none
GOOGLE_PLACES_API_KEY=your_server_side_google_places_api_key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Redis (opcional)
REDIS_URL=redis://localhost:6379

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key-here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project.iam.gserviceaccount.com

# Payment Gateways
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
MERCADOPAGO_ACCESS_TOKEN=your_mercadopago_access_token
PAGSEGURO_EMAIL=your_pagseguro_email
PAGSEGURO_TOKEN=your_pagseguro_token

# Platform Settings
PLATFORM_FEE_PERCENTAGE=0.05
PLATFORM_NAME=Socorre AI
PLATFORM_URL=https://yourdomain.com

# Email (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your_session_secret_here
