# T00 — Tow test environment template. NO REAL SECRETS.
#
# Copy to `.env.test` (git-ignored) before running the PostgreSQL harness:
#   cp .env.test.example .env.test
#
# How this file is actually loaded (T00 harness, Codex finding C1):
#   - `scripts/tow/test-env-file.js` loads `socorre_ai_backend/.env.test`
#     EXPLICITLY. `dotenv.config()` without a path (which loads `.env`) is not
#     used by the harness;
#   - entrypoints that load it: `scripts/tow/test-env.js`,
#     `scripts/tow/run-pg-gate.js`, `scripts/tow/verify.js`,
#     `scripts/tow/pg-guard.js` and `tests/helpers/tow/postgres.js` (which also
#     covers the Jest children spawned by the harness, because the resolved
#     target is exported to them);
#   - it is OPTIONAL: without it, the safe defaults in
#     `scripts/tow/pg-guard.js` apply (127.0.0.1:55432 / socorre_ai_tow_test /
#     tow_test / tow_test_password);
#   - shell/CI variables ALWAYS win: the file is never loaded with
#     `override: true`, and an empty value counts as unset;
#   - `socorre_ai_backend/.env` (development/production) is NEVER read by the
#     harness, so a developer `.env` cannot configure a test run;
#   - `TOW_TEST_ENV_FILE=<path>` overrides the file location (used by the
#     regression tests; relative paths resolve against `socorre_ai_backend/`).
#
# These values match docker-compose.test.yml, which starts a THROWAWAY
# PostgreSQL container with tmpfs storage. They are intentionally weak and must
# never be reused outside the disposable test environment. DB_PORT, DB_USER,
# DB_PASSWORD and DB_NAME_TEST are the SAME variables the compose file, the
# pg-guard and the Knex helper read (single source of truth, Codex finding C2).
#
# Note: with `TOW_POSTGRES_E2E=1` present here, `npm run test:tow` /
# `npx jest tests/tow` execute the PostgreSQL e2e suites and therefore need the
# disposable container up (`npm run test:pg:up`). `npm run verify:tow` keeps its
# offline stage offline and starts the container for the PostgreSQL stage.
#
# Safety contract enforced by scripts/tow/pg-guard.js:
#   - DB_HOST must be a loopback host (localhost / 127.0.0.1 / ::1);
#   - DB_NAME_TEST must end with `_test`;
#   - TOW_POSTGRES_E2E must be explicitly `1` to enable the PG harness;
#   - DATABASE_URL / PostgreSQL must not be set for the test environment.

# --- opt-in gate for the PostgreSQL harness -------------------------------
TOW_POSTGRES_E2E=1

# --- disposable PostgreSQL (docker-compose.test.yml) ----------------------
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME_TEST=socorre_ai_tow_test
DB_USER=tow_test
DB_PASSWORD=tow_test_password
DB_SSL=false

# --- test-only application secrets (placeholders, not used in production) --
NODE_ENV=test
JWT_SECRET=test-only-jwt-secret-not-a-real-secret

# --- external providers: always fakes in the default Tow suite ------------
# The Tow test foundation injects tests/helpers/tow/gateways/* doubles.
# Leave these empty so no real provider call can be made by accident.
GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_API_KEY=
STRIPE_SECRET_KEY=
MERCADOPAGO_ACCESS_TOKEN=
PAGSEGURO_TOKEN=
