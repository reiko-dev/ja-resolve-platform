# Tow local validation profile — TRACKED EXAMPLE, contains NO real secrets.
#
# This profile boots a THROWAWAY PostgreSQL container (tmpfs) plus the REAL
# backend against it, so a human can exercise the Tow module end to end:
#
#   cp .env.validation.example .env.validation
#   npm run tow:validation:up      # start the disposable database
#   npm run tow:validation:reset   # reset + migrate + seed the validation accounts
#   npm run start:validation       # boot the REAL backend on this profile
#   npm run tow:validation:smoke   # HTTP smoke; ends with RESET_AND_SEEDED
#   npm run tow:validation:down    # destroy the container/volume/network
#
# HARD RULES (enforced by scripts/tow/validation-env.js and pg-guard):
#   - validation/dev ONLY. Never copy this file to production or reuse its
#     values there;
#   - DB_PORT=55433 ON PURPOSE: 55432 belongs to an unrelated local project and
#     the shared test database (socorre_ai_tow_test / port 55432) must never be
#     touched by a validation run;
#   - DB_NAME_TEST must end with `_validation_test`; the CLI refuses otherwise;
#   - DB_HOST must be loopback and TOW_POSTGRES_E2E must be exactly `1`
#     (explicit opt-in for the disposable PostgreSQL harness);
#   - DATABASE_URL / PostgreSQL must NOT be set: every value is resolved from
#     this file, with shell values taking precedence.
#
# Switching the route provider to the real Google Routes API:
#   set GOOGLE_ROUTES_API_KEY=<key> and TOW_ROUTE_PROVIDER=google.
#   With the defaults below, TOW_ROUTE_PROVIDER=validation-fixture serves a
#   deterministic local fixture and no external call is ever made.
#
# Optional override of the seeded validation password (default lives in
# scripts/tow/validation-seed.js). It is a local-only throwaway credential and
# is printed by `npm run tow:validation:seed` so a tester can log in:
#   TOW_VALIDATION_PASSWORD=

# --- application profile ---------------------------------------------------
NODE_ENV=development
APP_ENV=validation
PORT=3000
HOST=0.0.0.0

# --- Tow providers: deterministic local doubles by default -----------------
TOW_PAYMENT_MODE=mock
TOW_ROUTE_PROVIDER=validation-fixture

# --- validation-only application secret (never a real credential) ----------
JWT_SECRET=validation-only-jwt-secret-not-a-real-secret

# --- disposable PostgreSQL (docker-compose.test.yml) -----------------------
TOW_POSTGRES_E2E=1
DB_HOST=127.0.0.1
DB_PORT=55433
DB_NAME=socorre_tow_validation_test
DB_NAME_TEST=socorre_tow_validation_test
DB_USER=tow_validation
DB_PASSWORD=tow_validation_password
DB_SSL=false

# --- external providers: empty so nothing real can be reached by accident --
GOOGLE_ROUTES_API_KEY=
GOOGLE_MAPS_API_KEY=

# --- private document storage for the validation profile -------------------
TOW_DOCUMENT_STORAGE_DIR=private/tow-documents-validation
