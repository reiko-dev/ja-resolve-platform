{
  "name": "socorre-ai-backend",
  "version": "1.0.0",
  "description": "Backend API para Socorre AI - Sistema de assistência automotiva",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "pretest": "node scripts/ensure-test-sqlite.js",
    "reset:e2e": "node scripts/reset-e2e-data.js",
    "db:migrate": "node scripts/tow/db-migrate.js",
    "db:seed": "node scripts/tow/db-seed.js",
    "db:reset": "node scripts/tow/db-reset.js",
    "db:assert": "node scripts/tow/db-baseline.js --assert",
    "db:snapshot": "node scripts/tow/schema-snapshot.js",
    "db:guard": "node scripts/tow/db-reset-guard.js --assert",
    "test:db-baseline": "node scripts/tow/run-db-baseline-gate.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:tow": "jest tests/tow --runInBand",
    "test:contract": "jest tests/contract --runInBand",
    "validate:openapi": "node scripts/tow/validate-openapi.js",
    "scan:secrets": "bash ../scripts/security/scan-secrets.sh",
    "test:pg": "node scripts/tow/run-pg-gate.js",
    "test:pg:up": "node scripts/tow/test-env.js up",
    "test:pg:wait": "node scripts/tow/test-env.js wait",
    "test:pg:down": "node scripts/tow/test-env.js down",
    "test:pg:guard": "node scripts/tow/test-env.js guard",
    "verify:tow": "node scripts/tow/verify.js",
    "verify:tow:offline": "node scripts/tow/verify.js --skip-postgres",
    "start:validation": "node scripts/tow/validation-server.js",
    "tow:validation:up": "node scripts/tow/validation-env.js up",
    "tow:validation:down": "node scripts/tow/validation-env.js down",
    "tow:validation:status": "node scripts/tow/validation-env.js status",
    "tow:validation:reset": "node scripts/tow/validation-env.js reset",
    "tow:validation:seed": "node scripts/tow/validation-env.js seed",
    "tow:validation:smoke": "node scripts/tow/validation-smoke.js"
  },
  "dependencies": {
    "axios": "^1.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.2.1",
    "firebase-admin": "^11.11.1",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.0.1",
    "morgan": "^1.10.0",
    "multer": "^2.1.0",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "socket.io-client": "^4.8.3",
    "sqlite3": "^5.1.6",
    "supertest": "^6.3.3",
    "yaml": "^2.9.1"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/database/migrations/**",
      "!src/database/seeders/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  },
  "keywords": [
    "socorre-ai",
    "backend",
    "api",
    "nodejs",
    "express"
  ],
  "author": "Socorre AI Team",
  "license": "MIT"
}
