# Socorre AI — Docker Compose environment template.
#
# Copy to `.env` in this directory (never commit it) or export the variables in
# the shell before running `docker compose`. The defaults below are exactly the
# local-development values the compose files used to hardcode; production
# deployments MUST override all of them.
#
# `docker compose` interpolates `${VAR:-default}` from the shell environment and
# from a `.env` file next to the compose file.

# PostgreSQL superuser password, consumed by the `postgres` service.
POSTGRES_PASSWORD=postgres

# Password the backend uses to connect to PostgreSQL. Keep it equal to
# POSTGRES_PASSWORD when using the bundled database.
DB_PASSWORD=postgres

# JWT signing secret. The value below is a public development placeholder and
# must never be used in production: with NODE_ENV=production the backend refuses
# to start unless JWT_SECRET is explicitly set.
JWT_SECRET=dev_jwt_secret_2025_change_in_production
